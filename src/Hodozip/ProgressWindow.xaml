<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hodozip.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="RootGrid"
        Padding="16,12,16,12"
        AutomationProperties.AutomationId="ProgressWindowRoot"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="DestinationText"
            Height="18"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <Grid
            Grid.Row="1"
            Margin="0,6,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                x:Name="ProgressBar"
                Height="10"
                VerticalAlignment="Center"
                IsIndeterminate="True" />
            <TextBlock
                x:Name="PercentText"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="0%"
                TextAlignment="Right" />
        </Grid>

        <TextBlock
            x:Name="CurrentFileText"
            Grid.Row="2"
            Height="18"
            Margin="0,8,0,0"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <ProgressBar
            x:Name="FileProgressBar"
            Grid.Row="3"
            Height="6"
            Margin="0,4,0,0"
            Maximum="1"
            Value="0" />

        <StackPanel
            Grid.Row="4"
            Margin="0,8,0,0"
            VerticalAlignment="Bottom"
            Spacing="2">
            <TextBlock
                x:Name="StatusText"
                Height="20"
                FontWeight="SemiBold"
                Text="解凍しています…"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="AutoCloseText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel
            Grid.Row="5"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="OpenFolderButton"
                Click="OpenFolderButton_Click"
                Content="フォルダを開く"
                Visibility="Collapsed" />
            <Button
                x:Name="CancelButton"
                Click="CancelButton_Click"
                Content="キャンセル" />
            <Button
                x:Name="CloseButton"
                Click="CloseButton_Click"
                Content="閉じる"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
