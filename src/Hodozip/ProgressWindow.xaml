<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hodozip.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,8" Spacing="3">
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="解凍" />
            <TextBlock
                x:Name="ArchiveNameText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,8,28,12"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="820"
                HorizontalAlignment="Center"
                Spacing="16">
                <Border
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="14">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">
                            <ProgressRing
                                x:Name="BusyRing"
                                Width="22"
                                Height="22"
                                IsActive="True" />
                            <TextBlock
                                x:Name="StatusTitle"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="解凍しています..." />
                        </StackPanel>

                        <ProgressBar
                            x:Name="ProgressBar"
                            IsIndeterminate="True" />

                        <Grid>
                            <TextBlock
                                x:Name="BytesText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                x:Name="PercentText"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>

                        <TextBlock
                            x:Name="CurrentFileText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ResultPanel"
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                x:Name="ResultSymbol"
                                FontSize="28"
                                FontWeight="Bold" />
                            <TextBlock
                                x:Name="ResultTitle"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="解凍先" />
                            <TextBlock
                                x:Name="DestinationText"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="ResultStatsText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <Expander
                            x:Name="IssuesExpander"
                            Header="警告・エラー"
                            Visibility="Collapsed">
                            <ScrollViewer
                                MaxHeight="220"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel
                                    x:Name="IssuesPanel"
                                    Spacing="8" />
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="AutoCloseText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="28,8,28,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="OpenFolderButton"
                Click="OpenFolderButton_Click"
                Content="フォルダを開く"
                Visibility="Collapsed" />
            <Button
                x:Name="CancelButton"
                Click="CancelButton_Click"
                Content="キャンセル" />
            <Button
                x:Name="CloseButton"
                Click="CloseButton_Click"
                Content="閉じる"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
