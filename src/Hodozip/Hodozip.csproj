<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Hodozip</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Hodozip.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationVersion>$(HodozipVersion)</ApplicationVersion>
    <Version>$(HodozipVersion)</Version>
    <AssemblyVersion>$(HodozipPackageVersion)</AssemblyVersion>
    <FileVersion>$(HodozipPackageVersion)</FileVersion>
    <AssemblyName>Hodozip</AssemblyName>
    <Product>Hodozip</Product>
    <Company>Ren9618</Company>
    <Copyright>Copyright (c) 2026 Rayno Works (Ren9618)</Copyright>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hodozip.Core\Hodozip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Hodozip.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    WinUI 3 の unpackaged アプリでは、XAML コンパイラが生成する .xbf と
    プロジェクトの .pri が既定の publish 項目に含まれない。
    これらが欠けると publish 版の起動時に Microsoft.UI.Xaml.dll がクラッシュするため、
    ビルド出力から publish 先へ明示的にコピーする。
  -->
  <Target Name="IncludeWinUIArtifactsInPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIArtifacts Include="$(TargetDir)*.xbf" />
      <_WinUIArtifacts Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WinUIArtifacts)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
