<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hodozip.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,8" Spacing="3">
            <TextBlock
                x:Name="AboutTitleText"
                FontSize="28"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="AboutSubtitleText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,8,28,12"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="700"
                HorizontalAlignment="Center"
                Spacing="16">
                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="Hodozip" />
                        <TextBlock
                            x:Name="VersionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="AboutTaglineText"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="SupportedFormatsHeaderText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="SupportedFormatsText"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SupportedFormatsNoteText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="LicenseHeaderText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="MIT License" />
                        <TextBlock
                            x:Name="CopyrightText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Expander x:Name="LicenseExpander">
                            <ScrollViewer
                                MaxHeight="260"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    x:Name="LicenseText"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Name="LibrariesHeaderText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="18" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="SharpCompress" />
                            <TextBlock
                                x:Name="SharpCompressLicenseText"
                                Grid.Row="0"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="SharpZipLib" />
                            <TextBlock
                                x:Name="SharpZipLibLicenseText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Microsoft Windows App SDK" />
                            <TextBlock
                                x:Name="WindowsAppSdkLicenseText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Text=".NET" />
                            <TextBlock
                                x:Name="DotNetLicenseText"
                                Grid.Row="3"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="PrivacyHeaderText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="PrivacyText"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="28,8,28,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="FeedbackButton"
                AutomationProperties.AutomationId="AboutFeedbackButton"
                Click="FeedbackButton_Click" />
            <Button
                x:Name="DonateButton"
                Click="DonateButton_Click" />
            <Button
                x:Name="CloseButton"
                Click="CloseButton_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
