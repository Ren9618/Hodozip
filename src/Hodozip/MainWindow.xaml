<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hodozip.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="36,28,36,12" Spacing="4">
            <TextBlock
                FontSize="34"
                FontWeight="SemiBold"
                Text="Hodozip" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="アーカイブを、ほどく。ドラッグ＆ドロップですぐに解凍できます。" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Padding="36,8,36,16"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="840"
                HorizontalAlignment="Center"
                Spacing="16">
                <Border
                    x:Name="DropZone"
                    MinHeight="280"
                    Padding="32"
                    AllowDrop="True"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="16"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <Border
                            Width="76"
                            Height="76"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="18">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="ZIP/7z" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="アーカイブをここにドロップ" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="または" />
                        <Button
                            x:Name="SelectFileButton"
                            Padding="26,8"
                            Click="SelectFileButton_Click"
                            Content="ファイルを選択"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsClosable="True"
                    IsOpen="False" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="ZIP / 7z / RAR / MSI / TAR / TAR.GZ / TAR.BZ2 / TAR.XZ / TAR.ZST / GZ / BZ2 / XZ / ZST に対応しています。単一フォルダのアーカイブは二重フォルダにせず、散らばったファイルはアーカイブ名のフォルダへ解凍します。"
                    TextWrapping="Wrap" />

                <Border
                    x:Name="RecentResultCard"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="前回の結果" />
                        <TextBlock
                            x:Name="RecentResultTitle"
                            FontSize="16"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="RecentResultDetails"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="RecentOpenFolderButton"
                                Click="RecentOpenFolderButton_Click"
                                Content="フォルダを開く" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="36,12,36,20">
            <TextBlock
                x:Name="VersionText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="AboutButton_Click"
                    Content="バージョン情報" />
                <Button
                    Click="SettingsButton_Click"
                    Content="設定" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
