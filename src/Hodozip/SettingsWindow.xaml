<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hodozip.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,8" Spacing="3">
            <TextBlock
                x:Name="SettingsTitleText"
                FontSize="28"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="SettingsSubtitleText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,8,28,12"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="680"
                HorizontalAlignment="Center"
                Spacing="16">
                <InfoBar
                    x:Name="SettingsInfoBar"
                    IsClosable="True"
                    IsOpen="False" />

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="DestinationSectionText"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="DestinationRuleComboBox"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem
                                    x:Name="DestinationSameAsArchiveItem"
                                    Tag="SameAsArchive" />
                            </ComboBox>
                            <TextBlock
                                x:Name="DestinationNoteText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="FolderCollisionSectionText"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="FolderCollisionComboBox"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem
                                    x:Name="FolderCollisionAskItem"
                                    Tag="Ask" />
                                <ComboBoxItem
                                    x:Name="FolderCollisionMergeItem"
                                    Tag="Merge" />
                                <ComboBoxItem
                                    x:Name="FolderCollisionAutoRenameItem"
                                    Tag="AutoRename" />
                            </ComboBox>
                            <TextBlock
                                x:Name="FolderCollisionNoteText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="OverwriteSectionText"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="OverwritePolicyComboBox"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem
                                    x:Name="OverwriteAskItem"
                                    Tag="Ask" />
                                <ComboBoxItem
                                    x:Name="OverwriteOverwriteItem"
                                    Tag="Overwrite" />
                                <ComboBoxItem
                                    x:Name="OverwriteSkipItem"
                                    Tag="Skip" />
                                <ComboBoxItem
                                    x:Name="OverwriteAutoRenameItem"
                                    Tag="AutoRename" />
                            </ComboBox>
                            <TextBlock
                                x:Name="OverwriteNoteText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <TextBlock
                            x:Name="BehaviorSectionText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch
                            x:Name="OpenFolderToggle" />
                        <StackPanel Spacing="4">
                            <ToggleSwitch
                                x:Name="CloseAfterExtractToggle" />
                            <TextBlock
                                x:Name="CloseAfterNoteText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="UpdatesSectionText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch
                            x:Name="CheckUpdatesToggle"
                            AutomationProperties.AutomationId="CheckUpdatesToggle" />
                        <TextBlock
                            x:Name="CheckUpdatesNoteText"
                            AutomationProperties.AutomationId="CheckUpdatesNoteText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="LanguageSectionText"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="LanguageComboBox"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="LanguageComboBox">
                                <ComboBoxItem Tag="System" />
                                <ComboBoxItem Tag="Japanese" />
                                <ComboBoxItem Tag="English" />
                            </ComboBox>
                            <TextBlock
                                x:Name="LanguageNoteText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="ParallelismSectionText"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="ParallelismComboBox"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ParallelismComboBox" />
                            <TextBlock
                                x:Name="ParallelismNoteText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="LegacySectionText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="LegacyNoteText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="LegacyContextMenuToggle"
                            Toggled="LegacyContextMenuToggle_Toggled" />
                        <TextBlock
                            x:Name="LegacyContextMenuStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="SupportSectionText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="SupportNoteText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="DonateButton"
                            Margin="0,4,0,0"
                            Click="DonateButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="28,8,28,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="CancelButton"
                Click="CancelButton_Click" />
            <Button
                x:Name="SaveButton"
                Click="SaveButton_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
