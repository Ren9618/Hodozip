<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hodozip.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,8" Spacing="3">
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="設定" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Hodozip の動作を設定します。" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Padding="28,8,28,12"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="680"
                HorizontalAlignment="Center"
                Spacing="16">
                <InfoBar
                    x:Name="SettingsInfoBar"
                    IsClosable="True"
                    IsOpen="False" />

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="解凍先" />
                            <ComboBox
                                x:Name="DestinationRuleComboBox"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem
                                    Content="アーカイブと同じ場所"
                                    Tag="SameAsArchive" />
                            </ComboBox>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="アーカイブの内容に応じて、解凍先フォルダを自動判定します。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="解凍先フォルダが既に存在するとき" />
                            <ComboBox
                                x:Name="FolderCollisionComboBox"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem
                                    Content="毎回確認する"
                                    Tag="Ask" />
                                <ComboBoxItem
                                    Content="既存のフォルダに解凍する"
                                    Tag="Merge" />
                                <ComboBoxItem
                                    Content="新しいフォルダを作成する（連番）"
                                    Tag="AutoRename" />
                            </ComboBox>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="「毎回確認する」では、解凍開始前に既存フォルダへ統合するか、連番の新しいフォルダを作るかを選べます。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="同名ファイルが既に存在するとき" />
                            <ComboBox
                                x:Name="OverwritePolicyComboBox"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem
                                    Content="毎回確認する"
                                    Tag="Ask" />
                                <ComboBoxItem
                                    Content="常に上書きする"
                                    Tag="Overwrite" />
                                <ComboBoxItem
                                    Content="常にスキップする"
                                    Tag="Skip" />
                                <ComboBoxItem
                                    Content="名前を変えて保存する"
                                    Tag="AutoRename" />
                            </ComboBox>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="「毎回確認する」では、新旧のサイズと更新日時を比較する上書き確認ダイアログを表示します。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="動作" />
                        <ToggleSwitch
                            x:Name="OpenFolderToggle"
                            Header="解凍完了後にフォルダを開く"
                            OffContent="オフ"
                            OnContent="オン" />

                        <StackPanel Spacing="4">
                            <ToggleSwitch
                                x:Name="CloseAfterExtractToggle"
                                Header="ダブルクリック起動時の完了後、自動で閉じる"
                                OffContent="オフ"
                                OnContent="オン" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="関連付けやコマンドラインから起動した場合に適用されます。エラー時は閉じません。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="従来型コンテキストメニュー" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Windows 10 形式の右クリックメニュー（Windows 11 では「その他のオプションを表示」側）に「Hodozip で解凍」を追加します。unpackaged 版のみ利用できます。"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="LegacyContextMenuToggle"
                            Header="従来型コンテキストメニューに登録する"
                            OffContent="解除"
                            OnContent="登録"
                            Toggled="LegacyContextMenuToggle_Toggled" />
                        <TextBlock
                            x:Name="LegacyContextMenuStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="開発を支援する" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Hodozip は無料・オープンソースです。支援は今後の開発とメンテナンスに使われます。"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,4,0,0"
                            Click="DonateButton_Click"
                            Content="開発を支援する"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="28,8,28,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Click="CancelButton_Click"
                Content="キャンセル" />
            <Button
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
